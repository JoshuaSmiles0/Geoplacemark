{{> nav active="mySites" }}
<h1 class="title is-underlined has-text-centered mt-4">{{title}}</h1>
<h2 class="subtitle">Posted by {{poi.author}}</h2>
<div class="columns">
    <div class="column is-2">
       <div class="message is-info">
          <div class="message-header">
            <img src="{{averageRatingImage}}" alt="rating">
          </div>
       </div>
   </div>
</div>
<div class="box">
   {{> poiDetails }}
</div>
<div class="box">
{{> ratingMetricsGraph}}
</div>
<div class="columns">
  <div class="column is-3">
<div class="box">
  <h1>
    Upload an image
  </h1>
</div>
  </div>
    </div>
<script>
  const fileInput = document.querySelector(".file-input");
  fileInput.onchange = () => {
    if (fileInput.files.length > 0) {
      const fileName = document.querySelector(".file-name");
      fileName.textContent = fileInput.files[0].name;
    }
  };
</script>
<form action="/poi/{{poi._id}}/uploadimage" method="POST" enctype="multipart/form-data">
      <div id="file-select" class="file has-name is-fullwidth">
        <label class="file-label"> <input class="file-input" name="imagefile" type="file" name="resume" accept="image/png, image/jpeg">
          <span class="file-cta">
            <span class="file-icon">
              <i class="fas fa-upload"></i>
            </span>
            <span class="file-label">
              Choose a file…
            </span>
           </span>
          <span class="file-name"></span>
        </label>
        <button type="submit" class="button is-info">Upload</button>
      </div>
    </form>
<h2 class="subtitle mt-4">Comments</h2>
{{> filterRating }}
{{> listRatings }}

